# Whop OAuth (see https://docs.whop.com/developer/guides/oauth)
# Created via `client.apps.create()` in the Whop dashboard/SDK
NEXT_PUBLIC_WHOP_APP_ID=app_xxxxxxxxx
WHOP_CLIENT_SECRET=whsec_xxxxxxxxx
WHOP_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Backend microservice (Render/Railway deployment URL, or http://localhost:8000 for local dev)
BACKEND_SERVICE_URL=http://localhost:8000

# Gemini API key -- server-side only, never exposed to the client bundle
GEMINI_API_KEY=your_gemini_api_key_here

# Skip Whop login locally so you can test the dashboard UI
DEV_SKIP_AUTH=true
